<?xml version="1.0" encoding="utf-8"?>
<!-- Splash nativa exibida antes do primeiro frame do Flutter. Fundo pasture
     com a marca centralizada — sem isso o usuário via um flash branco entre
     o toque no ícone e a tela de carregamento do app (main.dart). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
