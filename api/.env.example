# Ambiente de desenvolvimento da API.
#
# Copie para .env e ajuste se precisar:
#   cp .env.example .env
#   npm run dev
#
# O .env real é ignorado pelo git de propósito (ver .gitignore): credenciais
# de homologação e produção vêm de Vault/KMS, nunca de arquivo no repositório
# (Doc 13 §4.2). Os valores abaixo só valem no laboratório local.

# Porta da API. É a mesma que o app usa como default em
# app/lib/core/services.dart e em config/dev.json — mudar aqui sem mudar lá
# faz o app procurar a API no lugar errado.
PORT=4009

# Postgres do compose.dev.yml (compose.dev.yml expõe 5433 no host).
PGHOST=localhost
PGPORT=5433
PGUSER=traceagro_app
PGPASSWORD=traceagro_app_dev
PGDATABASE=traceagro

# Gateway Fabric simulado. Com "real" a API tenta falar com uma rede que só
# existe a partir da Fase 4 do roadmap.
FABRIC_MODE=simulated
