# Ambiente de desenvolvimento da API.
#
# Copie para .env e ajuste se precisar:
#   cp .env.example .env
#   npm run dev
#
# O .env real é ignorado pelo git de propósito (ver .gitignore): credenciais
# de homologação e produção vêm de Vault/KMS, nunca de arquivo no repositório
# (Doc 13 §4.2). Os valores abaixo só valem no laboratório local.

# Porta da API. É a mesma que o app usa como default em
# app/lib/core/services.dart e em config/dev.json — mudar aqui sem mudar lá
# faz o app procurar a API no lugar errado.
PORT=4009

# Postgres do compose.dev.yml (compose.dev.yml expõe 5433 no host).
PGHOST=localhost
PGPORT=5433
PGUSER=traceagro_app
PGPASSWORD=traceagro_app_dev
PGDATABASE=traceagro

# Toda rota de operação exige Bearer token. Em desenvolvimento, o login local
# valida a senha individual armazenada como hash no Postgres.
AUTH_MODE=dev
AUTH_JWT_SECRET=traceagro-dev-secret-change-me

# Prazo do token dev, em segundos (padrão: 30 dias). Revogação/suspensão de
# usuário são revalidadas no banco a cada requisição — um prazo longo não
# reduz segurança, só evita pedir login de novo do operador em campo depois
# de horas/dias sem sinal.
AUTH_TOKEN_TTL_SECONDS=2592000

# Gateway Fabric. "simulated" mantém o stub local. "real" usa um peer Fabric
# com identidade de serviço e TLS; veja blockchain/README.md.
FABRIC_MODE=simulated

# Obrigatório somente em FABRIC_MODE=real. Certificados/chaves ficam fora do Git.
# FABRIC_ENDPOINT=localhost:7051
# FABRIC_TLS_SERVER_NAME=peer0.org1.example.com
# FABRIC_MSP_ID=Org1MSP
# FABRIC_CHANNEL=traceagro-main
# FABRIC_CHAINCODE=traceagro-cc
# FABRIC_CLIENT_CERT_PATH=../blockchain/.runtime/.../signcerts/cert.pem
# FABRIC_CLIENT_KEY_PATH=../blockchain/.runtime/.../keystore/priv_sk
# FABRIC_TLS_ROOT_CERT_PATH=../blockchain/.runtime/.../tls/ca.crt
# FABRIC_ENDORSING_ORGS=Org1MSP,Org2MSP
