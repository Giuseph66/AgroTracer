# ---------------------------------------------------------------- segredos
# Nada de credencial real no repositório (Doc 13 §4.2). As senhas que existem
# em compose.dev.yml e no seed SQL são de laboratório local e não valem em
# nenhum outro ambiente — produção usa Vault/KMS.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
key.properties
secrets/
credentials.json
service-account*.json

# Material criptográfico da rede Fabric (Doc 10 §4) — MSP, CAs e identidades
# nunca entram em controle de versão.
crypto-config/
organizations/
wallet/
*.block
*.tx

# ------------------------------------------------------------------- Node
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

