app/android/app/release/
app/ios/Pods/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
*.iml

# ------------------------------------------------- ferramentas de agente
# Configuração local de assistentes: é ambiente de cada pessoa, não do projeto.
# AGENTS.md é a exceção deliberada — é a especificação que o time segue.
.claude/
.cursor/
.aider*
.continue/
.windsurf/
