# Configuração dos dois planos do deploy. Copie para deploy/.env e preencha.
# deploy/.env NÃO vai para o repositório.
#
#   cp .env.example .env
#
# O Compose lê este arquivo por estar no diretório do projeto (deploy/), tanto
# para substituir ${VARIAVEL} nos compose files quanto como env_file da API.

# ------------------------------------------------------------------ máquina
# Caminho ABSOLUTO do repositório NO HOST. compose.fabric.yml monta o
# repositório neste mesmo caminho dentro do container de ferramentas, porque os
# scripts do fabric-samples repassam caminhos daqui para bind mounts que o
# daemon do host resolve. Descubra com: cd .. && pwd
REPO_DIR=/opt/traceagro

# ------------------------------------------------------------------ Postgres
POSTGRES_SUPERUSER=traceagro
# Superusuário do banco; usado só pelas migrações e por manutenção.
POSTGRES_SUPERUSER_PASSWORD=troque-me-superusuario

# Credencial que a API usa. PGPASSWORD substitui, no primeiro boot, a senha de
# laboratório que a migração 002 escreve em texto no SQL.
PGUSER=traceagro_app
PGPASSWORD=troque-me-aplicacao
PGDATABASE=traceagro
PGPOOL_MAX=10

# ---------------------------------------------------------------- aplicação
PORT=4009

# AUTH_MODE=dev valida a senha individual guardada como hash no Postgres.
# Ao ligar o Keycloak/OIDC, troque para "oidc" e preencha OIDC_*.
AUTH_MODE=dev
# 32+ bytes aleatórios. Gere com: openssl rand -base64 48
AUTH_JWT_SECRET=troque-me-segredo-jwt
AUTH_TOKEN_TTL_SECONDS=2592000
# OIDC_ISSUER=
# OIDC_JWKS_URL=

# ecdsa exige assinatura P-256 sobre a mensagem canônica; legacy aceita as
# fixtures de desenvolvimento. Mantenha legacy só enquanto o app não assina.
EVENT_SIGNATURE_MODE=legacy

# simulated mantém o stub de âncora. Depois de subir a emulação e gerar
# deploy/fabric.env, aquele arquivo sobrepõe este valor com "real".
FABRIC_MODE=simulated
FABRIC_TIMEOUT_MS=15000

# ----------------------------------------------------------- conta inicial
# Usados pelo perfil "harden" (deploy/harden-accounts.cjs), nunca pela API.
# Passo obrigatório antes de abrir o túnel: as migrações 009/010 semeiam uma
# conta ADMO com senha conhecida e publicada no repositório.
ADMIN_BOOTSTRAP_EMAIL=giuseph@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=troque-me-senha-admin-forte

# ---------------------------------------------------------------- Cloudflare
# Token do túnel criado em Zero Trust > Networks > Tunnels. Ele carrega as
# rotas do túnel, então o hostname público é configurado no painel, não aqui.
CLOUDFLARE_TUNNEL_TOKEN=

# -------------------------------------------------------------------- tags
API_IMAGE_TAG=local
DB_IMAGE_TAG=local
FABRIC_OPS_TAG=local
FABRIC_VERSION=2.5.16

# Dono do material criptográfico gerado pela emulação Fabric. Precisa ser o uid
# do usuário `node` da imagem da API (1000), senão a API não lê a chave privada.
FABRIC_CRYPTO_UID=1000
